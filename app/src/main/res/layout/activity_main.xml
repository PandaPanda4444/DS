<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/resultTextView"
        android:layout_width="match_parent"
        android:layout_height="102dp"
        android:layout_marginBottom="4dp"
        android:background="#FFFFFF"
        android:gravity="start|top"
        android:padding="8dp"
        android:textColor="#000000"
        android:textSize="24sp" />

    <EditText
        android:id="@+id/inputExpression"
        android:layout_width="match_parent"
        android:layout_height="77dp"
        android:layout_marginBottom="4dp"
        android:background="#FFFFFF"
        android:hint="Enter expression"
        android:inputType="text"
        android:padding="8dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="fill"
        android:layout_weight="1"
        android:alignmentMode="alignBounds"
        android:columnCount="4"
        android:padding="4dp"
        android:rowCount="7"
        android:useDefaultMargins="false">

        <!-- Row 1 -->
        <Button
            android:id="@+id/btnClear"
            style="@style/CalculatorButton.Special"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="C" />

        <Button
            android:id="@+id/btnDivide"
            style="@style/CalculatorButton.Operator"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="÷" />

        <Button
            android:id="@+id/btnMultiply"
            style="@style/CalculatorButton.Operator"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="×" />

        <Button
            android:id="@+id/btnDelete"
            style="@style/CalculatorButton.Special"
            android:layout_row="0"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="⌫" />

        <!-- Row 2 -->
        <Button
            android:id="@+id/btn7"
            style="@style/CalculatorButton"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="7" />

        <Button
            android:id="@+id/btn8"
            style="@style/CalculatorButton"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="8" />

        <Button
            android:id="@+id/btn9"
            style="@style/CalculatorButton"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="9" />

        <Button
            android:id="@+id/btnMinus"
            style="@style/CalculatorButton.Operator"
            android:layout_row="1"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="-" />

        <!-- Row 3 -->
        <Button
            android:id="@+id/btn4"
            style="@style/CalculatorButton"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="4" />

        <Button
            android:id="@+id/btn5"
            style="@style/CalculatorButton"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="5" />

        <Button
            android:id="@+id/btn6"
            style="@style/CalculatorButton"
            android:layout_row="2"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="6" />

        <Button
            android:id="@+id/btnPlus"
            style="@style/CalculatorButton.Operator"
            android:layout_row="2"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="+" />

        <!-- Row 4 -->
        <Button
            android:id="@+id/btn1"
            style="@style/CalculatorButton"
            android:layout_row="3"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="1" />

        <Button
            android:id="@+id/btn2"
            style="@style/CalculatorButton"
            android:layout_row="3"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="2" />

        <Button
            android:id="@+id/btn3"
            style="@style/CalculatorButton"
            android:layout_row="3"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="3" />

        <Button
            android:id="@+id/btnEquals"
            style="@style/CalculatorButton.Equals"
            android:layout_row="3"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="=" />

        <!-- Row 5 (Power and Space) -->
        <Button
            android:id="@+id/btnPower"
            style="@style/CalculatorButton.Operator"
            android:layout_row="5"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:text="^" />

        <Button
            android:id="@+id/btnSpace"
            style="@style/CalculatorButton.Space"
            android:layout_row="5"
            android:layout_column="1"
            android:layout_columnSpan="3"
            android:layout_columnWeight="3"
            android:layout_gravity="fill"
            android:text="Space" />

    </GridLayout>
</LinearLayout>