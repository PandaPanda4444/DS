<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/resultTextView"
        android:layout_width="match_parent"
        android:layout_height="138dp"
        android:layout_marginBottom="8dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="start|top"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="#212121"
        android:textSize="20sp"
        android:textIsSelectable="true"
        android:fontFamily="monospace"
        android:lineSpacingExtra="4dp" />

    <EditText
        android:id="@+id/inputExpression"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:hint="Enter expression"
        android:inputType="text"
        android:padding="12dp"
        android:textSize="18sp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="5"
        android:rowCount="5"
        android:useDefaultMargins="true">

        <!-- Row 1 (Special operators) -->
        <Button
            android:id="@+id/btnClear"
            style="@style/CalculatorButton.Special"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="C" />
        <Button
            android:id="@+id/btnDelete"
            style="@style/CalculatorButton.Special"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="⌫" />
        <Button
            android:id="@+id/btnParenLeft"
            style="@style/CalculatorButton.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="(" />
        <Button
            android:id="@+id/btnParenRight"
            style="@style/CalculatorButton.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text=")" />
        <Button
            android:id="@+id/btnPower"
            style="@style/CalculatorButton.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="^" />

        <!-- Row 2 -->
        <Button
            android:id="@+id/btn7"
            style="@style/CalculatorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="7" />
        <Button
            android:id="@+id/btn8"
            style="@style/CalculatorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="8" />
        <Button
            android:id="@+id/btn9"
            style="@style/CalculatorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="9" />
        <Button
            android:id="@+id/btnDivide"
            style="@style/CalculatorButton.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="÷" />
        <Button
            android:id="@+id/btnMultiply"
            style="@style/CalculatorButton.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="×" />

        <!-- Row 3 -->
        <Button
            android:id="@+id/btn4"
            style="@style/CalculatorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="4" />
        <Button
            android:id="@+id/btn5"
            style="@style/CalculatorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="5" />
        <Button
            android:id="@+id/btn6"
            style="@style/CalculatorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="6" />
        <Button
            android:id="@+id/btnMinus"
            style="@style/CalculatorButton.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="-" />
        <Button
            android:id="@+id/btnPlus"
            style="@style/CalculatorButton.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="+" />

        <!-- Row 4 -->
        <Button
            android:id="@+id/btn1"
            style="@style/CalculatorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="1" />
        <Button
            android:id="@+id/btn2"
            style="@style/CalculatorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="2" />
        <Button
            android:id="@+id/btn3"
            style="@style/CalculatorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="3" />
        <Button
            android:id="@+id/btn0"
            style="@style/CalculatorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="0" />
        <Button
            android:id="@+id/btnDot"
            style="@style/CalculatorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="." />

        <!-- Row 5 -->
        <Button
            android:id="@+id/btnSpace"
            style="@style/CalculatorButton.Special"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="2"
            android:layout_columnSpan="2"
            android:text="Space" />
        <Button
            android:id="@+id/btnEquals"
            style="@style/CalculatorButton.Equals"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="3"
            android:layout_columnSpan="3"
            android:text="=" />
    </GridLayout>
</LinearLayout>